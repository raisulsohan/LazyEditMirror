{
  "manifestVersion": 5,
  "id": "com.lazyeditmirror.premiere",
  "name": "LazyEditMirror",
  "version": "1.1.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.5.0"
  },
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "schemes": ["lazyeditmirror"],
      "extensions": [""]
    }
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon-dark.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium"],
      "species": ["generic"]
    },
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon-light.png",
      "scale": [1, 2],
      "theme": ["light", "lightest"],
      "species": ["generic"]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-list.png",
      "scale": [1, 2],
      "species": ["pluginList"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "lazyeditmirror-panel",
      "label": {
        "default": "LazyEditMirror"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 760
      }
    }
  ]
}
